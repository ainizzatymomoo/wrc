# ==========================================
# BLESS2 Auto-Fill Environment Variables
# ==========================================
# Copy this file to .env and fill in your credentials

# BLESS2 Login Credentials
BLESS2_USERNAME=your_bless_id_here
BLESS2_PASSWORD=your_password_here

# OpenRouter AI API Key (for intelligent field recognition)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Override AI model (default: openai/gpt-4o-mini)
# AI_MODEL=openai/gpt-4o-mini
# AI_FALLBACK_MODEL=google/gemini-2.0-flash-001

# Optional: Override base URL
# BLESS2_BASE_URL=https://bless2.bless.gov.my/bless2/private
