# ==========================================
# BLESS2 Auto-Fill Environment Variables
# ==========================================
# Copy this file to .env and fill in your credentials

# BLESS2 Login Credentials
BLESS2_USERNAME=your_bless_id_here
BLESS2_PASSWORD=your_password_here

# Optional: Override base URL
# BLESS2_BASE_URL=https://bless2.bless.gov.my/bless2/private
